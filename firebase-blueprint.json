{
  "entities": {
    "AnalysisCache": {
      "title": "Analysis Cache",
      "description": "Cached football analysis results to save Gemini quota",
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "The AnalysisResult object"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the analysis was performed"
        }
      },
      "required": ["result", "timestamp"]
    }
  },
  "firestore": {
    "/analysis_cache/{cacheId}": {
      "schema": "AnalysisCache",
      "description": "Collection of cached match analyses"
    }
  }
}
