rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Analysis Cache: Server-side cache for analyses
    match /analysis_cache/{cacheId} {
      allow read, write: if true;
    }

    // Historical Matches: Publicly readable, writeable for sync
    match /historicalMatches/{matchId} {
      allow read: if true;
      allow write: if true; // Allow server-side sync even if unauthenticated in client SDK
    }

    // Team Styles and Profiles
    match /team_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    match /team_style_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Referee Profiles
    match /referee_profiles/{refereeId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
