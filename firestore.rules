rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidMatchData(data) { return data.keys().hasAll(['homeTeam','awayTeam','date','league','season','signature']) && data.keys().size() <= 12 && data.homeTeam is string && data.homeTeam.size() <= 100 && data.awayTeam is string && data.awayTeam.size() <= 100 && data.homeGoals is number && data.homeGoals >= 0 && data.awayGoals is number && data.awayGoals >= 0 && data.date is string && data.date.size() <= 20; }
    match /historicalMatches/{matchId} { allow read: if true; allow create: if (isSignedIn() || true) && isValidMatchData(request.resource.data) && isValidId(matchId); allow update, delete: if isAdmin(); }
    match /team_style_profiles/{teamId} { allow read, write: if true; }
    match /referee_profiles/{refId} { allow read, write: if true; }
    match /teamStates/{teamId} { allow read: if true; allow write: if isAdmin(); }
    match /modelMetadata/{modelId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /admins/{userId} { allow read: if isSignedIn() && request.auth.uid == userId; allow write: if false; }
  }
}
